# 密钥与本地环境
.env
.venv/

# Python
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# 本地工具产物
.video_agent/

# 应用运行时数据（SQLite 库与导入中的快照不入库；data/notes 结论快照入库，可 git diff）
data/*.db
data/snapshot/
# 摄取层当日磁盘缓存（反爬纪律产物，可随时删）
data/cache/
# 生产访问日志（滚动，可随时删）
data/logs/
# 写接口鉴权 token（凭据，绝不入库）
data/auth_token.txt
# UI 验收截图（含真实持仓信息，本仓为公开仓，不入库）
data/shots/

# Node / 前端
node_modules/
frontend/dist/
*.local
